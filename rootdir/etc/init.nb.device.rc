# init.nb.rc
# For all nubia projects defined in device/zte

service vendor.gx_fpd /vendor/bin/gx_fpd
    class core
    user system
    group system
    writepid /dev/cpuset/system-background/tasks

service vendor.goodix_script /vendor/bin/init.goodix.sh
    class late_start
    user system
    oneshot

on property:goodix.fp.service.ready=1
   start vendor.fps_hal
on property:persist.sys.fp.onstart=1
   start vendor.fps_hal

